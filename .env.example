# =============================================================================
# AI Investment / Intraday Trading System — example environment
# =============================================================================
# Copy to `.env` and fill in locally.  NEVER commit `.env`.
# Every value below is a NAME ONLY — no real credentials belong in this file.
#
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Application environment
#   development | test | production
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=json            # json | console

# -----------------------------------------------------------------------------
# Trading mode  (architecture v0.3 §19.1)
#   backtest | paper | live
#
# PAPER is the default and the only sane local value.
# LIVE is BLOCKED IN CODE and is not implemented — see app/config/settings.py.
# -----------------------------------------------------------------------------
TRADING_MODE=paper

# Deliberate-arming flags for LIVE.  Not honoured until the live phase.
LIVE_TRADING_ARMED=false
LIVE_CAPITAL_CEILING_INR=0

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Docker Compose default (see infra/docker-compose.yml):
DATABASE_URL=postgresql+psycopg://aitrade:aitrade@localhost:5432/aitrade
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5
DB_ECHO=false

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Broker — Zerodha Kite Connect
#
# READ-ONLY MARKET DATA ONLY. There is no order endpoint in this build.
#
# The application starts and serves without these; it simply has no live feed
# and reports ZERODHA_NOT_CONFIGURED honestly.
#
# API key and secret come from https://developers.kite.trade (your app).
# The access token is minted daily and EXPIRES AT 06:00 IST the next morning
# (a regulatory requirement), so it must be refreshed each trading day:
#
#   1. open the login URL printed by the app, or build it yourself:
#        https://kite.zerodha.com/connect/login?v=3&api_key=YOUR_KEY
#   2. log in; Kite redirects to your registered URL with ?request_token=...
#   3. exchange it for an access token (see README, "Zerodha setup")
# -----------------------------------------------------------------------------
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_API_ROOT=https://api.kite.trade
ZERODHA_WS_ROOT=wss://ws.kite.trade
ZERODHA_TIMEOUT_SECONDS=15

# -----------------------------------------------------------------------------
# Market data
# -----------------------------------------------------------------------------
# zerodha | replay | none.  "replay" is deterministic offline data and is never
# presented as live.
MARKET_DATA_PROVIDER=zerodha
# ltp | quote | full.  full adds exchange timestamps, open interest and depth.
MARKET_DATA_MODE=full

# The tradable universe is EXPLICIT configuration, as EXCHANGE:TRADINGSYMBOL.
# Instrument tokens are never hard-coded - they are resolved through the
# instrument master, because exchanges reuse tokens after derivative expiry.
# Index entries are subscribed for data but are NOT directly tradable.
MARKET_DATA_UNIVERSE=NSE:NIFTY 50,NSE:NIFTY BANK,NSE:RELIANCE,NSE:HDFCBANK,NSE:INFY

# 1m is mandatory: 5m and 15m are aggregated from completed 1-minute bars.
MARKET_DATA_INTERVALS=1m,5m,15m
MARKET_DATA_PERSIST_TICKS=true
MARKET_DATA_TICK_STALE_SECONDS=30
MARKET_DATA_STREAM_STALE_SECONDS=60
MARKET_DATA_FLUSH_SECONDS=1
INSTRUMENT_MASTER_MAX_AGE_HOURS=24

# WebSocket reconnection. 0 attempts means keep retrying; every attempt and the
# resulting data gap are recorded.
WS_RECONNECT_INITIAL_SECONDS=1
WS_RECONNECT_MAX_SECONDS=30
WS_RECONNECT_MAX_ATTEMPTS=0

# -----------------------------------------------------------------------------
# Compliance profile  (architecture v0.3 §0.3 / T-19)
# Must be confirmed in writing with Zerodha before LIVE is ever enabled.
# NOT IMPLEMENTED IN PHASE 0.
# -----------------------------------------------------------------------------
COMPLIANCE_ALGO_ID=
COMPLIANCE_CLASSIFICATION=
COMPLIANCE_REGISTERED_IP=
COMPLIANCE_CONFIRMATION_REF=

# -----------------------------------------------------------------------------
# TradingView webhook — NOT IMPLEMENTED (no webhook endpoint exists)
# -----------------------------------------------------------------------------
TRADINGVIEW_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# LLM — NOT IMPLEMENTED (no LLM client is wired into the application)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Frontend (Next.js) — public, safe to expose to the browser
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
